# Usa pares separados para impedir que una llave de pruebas llegue a producción.
BOLD_ENVIRONMENT=test
# Desarrollo y Preview:
BOLD_TEST_IDENTITY_KEY=
BOLD_TEST_SECRET_KEY=
# Producción en Vercel:
BOLD_PRODUCTION_IDENTITY_KEY=
BOLD_PRODUCTION_SECRET_KEY=

# Compatibilidad local con configuraciones anteriores. No los uses en producción.
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=

# Vercel/Neon la genera al conectar la base de datos desde Marketplace.
# En desarrollo puede quedar vacía para usar archivos bajo var/.
DATABASE_URL=

# URL pública HTTPS al desplegar. En local Bold exige localhost y no 127.0.0.1.
PUBLIC_BASE_URL=http://localhost:4173
PORT=4173

# Producción permanece bloqueada incluso con llaves reales hasta cambiar este valor.
# Primero despliega con false, valida production_locked y solo entonces cambia a true.
ALLOW_BOLD_PRODUCTION=false

# Acceso al panel endurecido. Genera estos valores con: npm run admin:security:setup
ADMIN_EMAIL=
# Cuenta propietaria que reemplaza definitivamente el acceso de transición al activarse.
ADMIN_MASTER_EMAIL=adminmaster@querubim.com
# ADMIN_PASSWORD solo permite migrar una clave local existente. No la conserves en producción.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_TOTP_SECRET=
ADMIN_TOTP_REQUIRED=true
ADMIN_SECURITY_ENFORCED=true

# Cloudflare R2 para las imágenes administradas desde el panel.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
