# Usa siempre las llaves del mismo ambiente. Nunca publiques la llave secreta.
BOLD_ENVIRONMENT=test
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=

# Vercel/Neon la genera al conectar la base de datos desde Marketplace.
# En desarrollo puede quedar vacía para usar archivos bajo var/.
DATABASE_URL=

# URL pública HTTPS al desplegar. En local Bold exige localhost y no 127.0.0.1.
PUBLIC_BASE_URL=http://localhost:4173
PORT=4173

# Déjalo vacío hasta que el responsable contable confirme el impuesto aplicable.
BOLD_TAX=

# Producción permanece bloqueada incluso con llaves reales hasta cambiar este valor.
ALLOW_BOLD_PRODUCTION=false
